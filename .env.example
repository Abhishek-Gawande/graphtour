# ── graphtour configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# Backend selector: "cloud" (Cognee Cloud, iPhone track) or "local" (self-hosted, MacBook track)
COGNEE_BACKEND=cloud

# ── Cognee Cloud (used when COGNEE_BACKEND=cloud) ──────────────────────────
# Your tenant URL from the Cognee Cloud console, e.g. https://your-tenant.aws.cognee.ai
COGNEE_CLOUD_URL=
# API key generated on the "API Keys" page of the Cognee Cloud console
COGNEE_API_KEY=
# Optional reference values (SDK connects with URL + key; these are for REST/debugging)
COGNEE_TENANT_ID=
COGNEE_USER_ID=

# ── Self-hosted (used when COGNEE_BACKEND=local) ───────────────────────────
# LLM provider key for local graph building (e.g. OpenAI). Only needed for local backend.
LLM_API_KEY=
